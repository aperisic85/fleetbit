VITE_APP_MODE=svante
VITE_CAMERA_URL=http://192.168.81.251
# Fokus karte: Kanal sv. Ante (Šibenik) — Jadrija ↔ Martinska
VITE_MAP_CENTER_LAT=43.7265
VITE_MAP_CENTER_LON=15.8665
VITE_MAP_CENTER_ZOOM=15
# Ograničenje brzine u kanalu (čvorovi)
VITE_SPEED_LIMIT_KN=10

# Polumjer nadzorne zone oko centra kanala (NM) — izvan toga se plovila ne
# prate (samo Kanal sv. Ante i prilazi, ne cijeli Jadran)
VITE_MONITOR_RADIUS_NM=1.5

# ── Detekcija rizika sudara (CPA/TCPA/CRI) ──
# DCPA prag za upozorenje / alarm (nautičke milje)
VITE_CPA_WARN_NM=0.15
VITE_CPA_ALARM_NM=0.05
# Najveći TCPA koji se prati (sekunde)
VITE_TCPA_HORIZON_S=600
# Horizont crtanja predviđene putanje (sekunde)
VITE_PREDICT_S=240
# Plovila sporija od ovoga tretiraju se kao stacionarna (čvorovi)
VITE_COLLISION_MIN_SPEED_KN=0.5
