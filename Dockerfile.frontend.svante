FROM node:22-alpine AS builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build:svante && mv dist/svante.html dist/index.html

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY frontend/nginx.svante.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
