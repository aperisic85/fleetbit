{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            vl.mmsi,\n            v.name,\n            vl.lat,\n            vl.lon,\n            vl.sog,\n            vl.cog,\n            vl.heading,\n            vl.nav_status,\n            vl.last_seen\n        FROM vessel_latest vl\n        LEFT JOIN vessels v ON v.mmsi = vl.mmsi\n        WHERE vl.last_seen > NOW() - INTERVAL '2 hours'\n        ",
